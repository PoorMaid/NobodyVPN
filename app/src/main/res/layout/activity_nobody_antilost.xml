<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/baseline_arrow_back_24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_direct_apk"
                style="@style/Widget.Nobody.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/nobody_antilost_direct_apk" />

            <TextView
                style="@style/Nobody.SectionTitle"
                android:text="@string/nobody_antilost_free_vpn_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_privado"
                style="@style/Widget.Nobody.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/nobody_antilost_privado" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_proton"
                style="@style/Widget.Nobody.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/nobody_antilost_proton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_warp"
                style="@style/Widget.Nobody.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/nobody_antilost_warp" />

            <TextView
                style="@style/Nobody.SectionTitle"
                android:text="@string/nobody_antilost_sub_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nekobox_dl"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_nekobox" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_v2rayng"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_v2rayng" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clash_meta"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_clash_meta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_singbox"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_singbox" />
            </LinearLayout>

            <TextView
                style="@style/Nobody.SectionTitle"
                android:text="@string/nobody_antilost_endgfw_title" />

            <TextView
                android:id="@+id/link_endgfw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/nobody_antilost_endgfw_visit"
                android:textColor="@color/nobody_accent_text"
                android:textSize="15sp" />

            <TextView
                style="@style/Nobody.SectionTitle"
                android:text="@string/nobody_antilost_copy_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fmt1"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_fmt1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fmt2"
                    style="@style/Widget.Nobody.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/nobody_antilost_fmt2" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/nobody_antilost_footer"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
